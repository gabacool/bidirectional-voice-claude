# Voice client configuration
# Copy this file to config.yaml and update settings.
#
# Switch TTS with local.tts_engine only. Each engine keeps its own block so
# unused engines stay configured and do not leak speaker/instruct/model into
# the active one. Shared playback (speed, seek, pause) lives at local top-level.

# Backend: "origin" (GPU server via WebSocket) or "local" (Apple Silicon via MLX)
backend: local

# Audio settings
sample_rate: 16000       # Must match model expectation
chunk_duration: 0.1      # Send audio every 100ms
max_record_seconds: 120  # Hard cap; recording auto-stops after this many seconds

# Origin backend - GPU server over network
origin:
  server_url: "ws://YOUR_SERVER_IP:8087"
  tts_server_url: "ws://YOUR_SERVER_IP:8088"

# Local backend - Apple Silicon (MLX) for STT; TTS engine is chosen below
# First run of Qwen STT/TTS downloads models automatically from HuggingFace
local:
  # STT (speech-to-text) - Qwen3-ASR via mlx-qwen3-asr
  stt_model: "Qwen/Qwen3-ASR-0.6B"

  # LAN voice API (voice_api.py)
  voice_api_port: 9900              # OpenAI-compatible: POST /v1/audio/transcriptions,
                                    # POST /v1/audio/speech. Legacy: /transcribe, /synthesize.

  # Playback shared by every TTS engine
  tts_speed: 1.0                    # Playback speed, pitch preserved (1.0 normal, 1.5 faster)
  tts_seek_seconds: 15              # Option+< / Option+> step while speaking
  tts_max_pause_seconds: 0.2        # Cap inter-sentence silence on the batch path (0 = off)

  # Active TTS engine: edge | qwen | breeze | vireo
  tts_engine: edge

  # --- edge (internet, no GPU) ---
  # List voices: edge-tts --list-voices
  edge:
    voice: "en-US-EmmaMultilingualNeural"
    rate: "+0%"                     # if omitted, derived from tts_speed (1.2 -> +20%)
    volume: "+0%"
    pitch: "+0Hz"

  # --- qwen (on-device Qwen3-TTS via mlx-audio) ---
  # Speakers: aiden, ryan (EN male); serena, vivian (ZH female);
  # dylan, eric, uncle_fu (ZH male); ono_anna (JA); sohee (KO).
  # Keep temperature in 0.7–1.0 or the model collapses to silence.
  qwen:
    model: "mlx-community/Qwen3-TTS-12Hz-1.7B-CustomVoice-8bit"
    # model: "mlx-community/Qwen3-TTS-12Hz-1.7B-CustomVoice-4bit"   # ~2x faster
    # model: "mlx-community/Qwen3-TTS-12Hz-0.6B-CustomVoice-4bit"   # fastest
    speaker: aiden
    language: english               # auto, english, chinese, german, french, spanish, ...
    instruct: "calm, consistent conversational tone"
    temperature: 0.7
    top_k: 50
    top_p: 1.0
    repetition_penalty: 1.1
    max_tokens: 4096                # ~12.5 tokens/s of audio; ceiling is 32768
    streaming_interval: 2.0         # seconds of audio per chunk

  # --- breeze (on-device Breeze TTS 2 via mlx-audio, ~3GB). Research/non-commercial. ---
  # Slower than realtime on this Mac. Auto-builds client/voices/breeze_lock.wav
  # from instruct, then clones it. Optional ref_audio + ref_text skips the lock.
  breeze:
    model: "mlx-community/Breeze-TTS-2-mlx-4bit"
    # model: "mlx-community/Breeze-TTS-2-mlx-8bit"
    # model: "mlx-community/Breeze-TTS-2-mlx"
    instruct: "A warm, thoughtful young American woman with a clear voice."
    cfg_scale: 4                    # lock-clip design strength
    seed: 42
    # Clone a wav instead of the auto lock. BOTH keys are required: mlx-audio
    # raises if ref_audio is set without the exact transcript of that clip.
    # ~5–15s, mono, quiet room. Uncomment both, or leave both commented.
    # ref_audio: "/Users/gabagool/Git/nvidia_parakeet/client/voices/breeze_lock.wav"
    # ref_text: "Hello. This is a calm American woman speaking clearly, like a podcast host."
    # ref_audio: "/Users/gabagool/Git/nvidia_parakeet/client/voices/my_voice.wav"
    # ref_text: "The exact sentence you spoke in that recording."

  # --- vireo (pruned mixed-4-bit Breeze via breeze_mlx, ~2.1GB, gated HF). ---
  # Faster than realtime at cfg_scale 1. Default clones breeze_lock.wav.
  # Empty ref_audio falls back to voice design. Clone needs exact ref_text.
  # Clips longer than 8s (English+Chinese stitches) are packed to ~4s of
  # each language so the 2048 context does not go analog-radio.
  vireo:
    model: "mchen04/Vireo-TTS-3B-MLX-mixed4bit"
    speaker: S0
    instruct: "A warm, thoughtful young American woman with a clear voice."
    cfg_scale: 1                    # 1.0 = realtime clone; 4.0 is the slow two-branch
    seed: 42
    # ref_audio: "/Users/you/Git/nvidia_parakeet/client/voices/my_voice.wav"
    # ref_text: "The exact sentence spoken in that wav."

# Optional terminal voice-chat overrides (agent_voice: claude-voice / hermes-voice / grok-voice)
#
# Session bridging (hop between the interactive agent TUI and voice on the
# SAME conversation) is done via CLI flags, NOT this config:
#   --cwd DIR            pin the agent's working directory (any agent)
#   --continue           claude/grok: resume the most recent session in --cwd
#   --resume SESSION_ID  claude/grok: resume a specific session by id
#   --model MODEL        claude/grok: model for the session
#   --effort {low,medium,high}   grok only: reasoning effort
# --continue and --resume are mutually exclusive; hermes supports neither.
#voice_chat:
#  endpoint: "http://127.0.0.1:9900"
#  rms_threshold: 0.015        # calibrate with claude-voice --debug
#  speech_confirm_ms: 300
#  silence_confirm_ms: 2000
#  max_utterance_ms: 120000
#  sentences_per_call: 2
#  inter_clip_pause_ms: 200
#  voice: ryan
